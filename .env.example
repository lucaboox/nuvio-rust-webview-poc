# Public client configuration injected into official Nuvio release builds.
# Copy this file to .env.local and provide the release/dev values.
NUVIO_SUPABASE_URL=
NUVIO_SUPABASE_ANON_KEY=
NUVIO_SUPABASE_FALLBACK_URL=

# Optional development-only escape hatch for a Stremio addon running on your
# LAN or localhost. Private destinations are blocked by default.
NUVIO_ALLOW_PRIVATE_ADDONS=0
